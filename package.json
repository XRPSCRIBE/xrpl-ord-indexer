{
  "name": "xrpl-ord-indexer",
  "version": "0.1.0",
  "description": "Indexer for XRPL inscriptions (the `ord` protocol): finds every inscription on the XRP Ledger, in order, and rebuilds its content from transaction memos.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "xrpl-ord-index": "dist/cli.js"
  },
  "files": [
    "dist",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "index": "tsx src/cli.ts"
  },
  "keywords": ["xrpl", "xrp", "ordinals", "inscriptions", "ord", "indexer"],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
